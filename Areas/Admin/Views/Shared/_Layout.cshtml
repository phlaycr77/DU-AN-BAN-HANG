@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - Quản trị Karl Shop</title>

    <link href="~/admin/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/admin/css/metisMenu.min.css" rel="stylesheet">
    <link href="~/admin/css/timeline.css" rel="stylesheet">
    <link href="~/admin/css/startmin.css" rel="stylesheet">
    <link href="~/admin/css/font-awesome.min.css" rel="stylesheet" type="text/css">
    <style>
        .thumb-sm { width: 50px; height: 60px; object-fit: cover; border-radius: 3px; }
        .table > tbody > tr > td { vertical-align: middle; }
        .btn-inline-form { display: inline; }
        .preview-img { max-width: 180px; max-height: 220px; border: 1px solid #ddd; padding: 3px; border-radius: 3px; }
    </style>
</head>
<body>
    <div id="wrapper">

        <!-- Top Navigation -->
        <nav class="navbar navbar-inverse navbar-fixed-top" role="navigation">
            <div class="navbar-header">
                <a class="navbar-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Karl Shop - Quản trị</a>
            </div>

            <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                <span class="sr-only">Toggle navigation</span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
            </button>

            <!-- Left Menu -->
            <ul class="nav navbar-nav navbar-left navbar-top-links">
                <li><a asp-area="" asp-controller="Home" asp-action="Index" target="_blank"><i class="fa fa-home fa-fw"></i> Xem website</a></li>
            </ul>

            <!-- Right Menu -->
            <ul class="nav navbar-right navbar-top-links">
                <li class="dropdown">
                    <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                        <i class="fa fa-user fa-fw"></i> @User.Identity.Name <b class="caret"></b>
                    </a>
                    <ul class="dropdown-menu dropdown-user">
                        <li>
                            <a href="#" onclick="document.getElementById('logoutForm').submit(); return false;"><i class="fa fa-sign-out fa-fw"></i> Đăng xuất</a>
                        </li>
                    </ul>
                </li>
            </ul>
            <form id="logoutForm" asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post" style="display:none"></form>
        </nav>

        <!-- Sidebar -->
        <aside class="sidebar navbar-default" role="navigation">
            <div class="sidebar-nav navbar-collapse">
                <ul class="nav" id="side-menu">
                    <li>
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="@(controller == "Dashboard" ? "active" : "")"><i class="fa fa-dashboard fa-fw"></i> Tổng quan</a>
                    </li>
                    <li>
                        <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="@(controller == "Categories" ? "active" : "")"><i class="fa fa-sitemap fa-fw"></i> Danh mục</a>
                    </li>
                    <li>
                        <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="@(controller == "Products" ? "active" : "")"><i class="fa fa-tags fa-fw"></i> Sản phẩm</a>
                    </li>
                    <li>
                        <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="@(controller == "Orders" ? "active" : "")"><i class="fa fa-shopping-cart fa-fw"></i> Đơn hàng</a>
                    </li>
                </ul>
            </div>
        </aside>

        <!-- Page Content -->
        <div id="page-wrapper">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-lg-12">
                        <h1 class="page-header">@ViewData["Title"]</h1>
                    </div>
                </div>

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissable">
                        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
                        @TempData["Success"]
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissable">
                        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
                        @TempData["Error"]
                    </div>
                }

                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/admin/js/jquery.min.js"></script>
    <script src="~/admin/js/bootstrap.min.js"></script>
    <script src="~/admin/js/metisMenu.min.js"></script>
    <script src="~/admin/js/startmin.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
