@model List<Product>
@{
    ViewData["Title"] = "Sản phẩm";
}

<p><a asp-action="Create" class="btn btn-primary"><i class="fa fa-plus"></i> Thêm sản phẩm</a></p>

<div class="panel panel-default">
    <div class="panel-body">
        @if (!Model.Any())
        {
            <p class="text-muted">Chưa có sản phẩm nào.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            <th style="width:60px">#</th>
                            <th style="width:80px">Ảnh</th>
                            <th>Tên sản phẩm</th>
                            <th>Danh mục</th>
                            <th>Giá bán</th>
                            <th style="width:130px">Ngày tạo</th>
                            <th style="width:150px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td>@p.Id</td>
                                <td><img class="thumb-sm" src="@Url.Content(ViewHelpers.ImagePath(p.ImageUrl))" alt="@p.Name" /></td>
                                <td>@p.Name</td>
                                <td>@p.Category?.Name</td>
                                <td>@p.Price.ToVnd()</td>
                                <td>@p.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-xs btn-warning"><i class="fa fa-pencil"></i> Sửa</a>
                                    <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-xs btn-danger"><i class="fa fa-trash-o"></i> Xóa</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
