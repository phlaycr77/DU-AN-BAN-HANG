@model List<Order>
@{
    ViewData["Title"] = "Đơn hàng";
    OrderStatus? current = ViewBag.Status;
}

<ul class="nav nav-pills" style="margin-bottom:15px">
    <li class="@(current == null ? "active" : "")"><a asp-action="Index">Tất cả</a></li>
    @foreach (OrderStatus s in Enum.GetValues(typeof(OrderStatus)))
    {
        <li class="@(current == s ? "active" : "")"><a asp-action="Index" asp-route-status="@((int)s)">@s.GetDisplayName()</a></li>
    }
</ul>

<div class="panel panel-default">
    <div class="panel-body">
        @if (!Model.Any())
        {
            <p class="text-muted">Không có đơn hàng nào.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Điện thoại</th>
                            <th>Ngày đặt</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th style="width:90px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model)
                        {
                            <tr>
                                <td>#@o.Id</td>
                                <td>@o.CustomerName</td>
                                <td>@o.Phone</td>
                                <td>@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@o.TotalAmount.ToVnd()</td>
                                <td><span class="label @o.Status.BadgeClass()">@o.Status.GetDisplayName()</span></td>
                                <td><a asp-action="Details" asp-route-id="@o.Id" class="btn btn-xs btn-primary"><i class="fa fa-eye"></i> Chi tiết</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
